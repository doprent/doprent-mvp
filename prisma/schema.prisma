// Monetization
// ---------------------------------------------------------------------------

/// แผนสมาชิกแบบเสียเงินของร้าน (เดิม seller_subscriptions) — ขับเคลื่อน MRR
model ShopSubscription {
  /// Primary key (uuid)
  id               String       @id @default(uuid()) @db.Uuid
  /// FK → shops.id (Cascade)
  shopId           String?      @map("shop_id") @db.Uuid
  /// FK → users.id เจ้าของ (SetNull)
  ownerId          String?      @map("owner_id") @db.Uuid
  /// แผนที่สมัคร
  plan             PlanTier     @default(free)
  /// สถานะ subscription
  status           SubStatus    @default(active)
  /// ยอดจ่ายต่อรอบ (บาท)
  amount           Int          @default(0)
  /// รอบบิล (รายเดือน/รายปี)
  billingCycle     BillingCycle @default(monthly) @map("billing_cycle")
  /// เวลาเริ่ม subscription
  startedAt        DateTime?    @default(now()) @map("started_at") @db.Timestamptz(6)
  /// เวลาสิ้นสุดรอบบิลปัจจุบัน
  currentPeriodEnd DateTime?    @map("current_period_end") @db.Timestamptz(6)
  /// เวลายกเลิก
  cancelledAt      DateTime?    @map("cancelled_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop  Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([status])
  @@index([plan])
  @@map("shop_subscriptions")
}

// ---------------------------------------------------------------------------
// Bookings (Phase 1: self-serve booking + PromptPay slip upload)
// ---------------------------------------------------------------------------

/// ที่อยู่จัดส่งของผู้ใช้
model Address {
  /// Primary key (uuid)
  id            String  @id @default(uuid()) @db.Uuid
  /// FK → users.id (Cascade)
  userId        String  @map("user_id") @db.Uuid
  /// ป้ายชื่อที่อยู่ (บ้าน/ที่ทำงาน)
  label         String
  /// ชื่อผู้รับ
  recipientName String  @map("recipient_name")
  /// เบอร์โทรผู้รับ
  phone         String
  /// ที่อยู่บรรทัดหลัก
  addressLine   String  @map("address_line")
  /// แขวง/ตำบล
  subdistrict   String?
  /// เขต/อำเภอ
  district      String?
  /// จังหวัด
  province      String? @default("กรุงเทพมหานคร")
  /// รหัสไปรษณีย์
  postalCode    String  @map("postal_code")
  /// LINE ID ของผู้รับ (ใช้ประสานงานกับร้าน)
  lineId        String? @map("line_id")
  /// ที่อยู่หลัก (default) ของผู้ใช้
  isDefault     Boolean @default(false) @map("is_default")

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

/// บัญชีธนาคารของผู้ใช้ (ใช้รับเงินมัดจำคืน — pattern เดียวกับ Address)
model BankAccount {
  /// Primary key (uuid)
  id            String   @id @default(uuid()) @db.Uuid
  /// FK → users.id (Cascade — ลบ user → ลบบัญชีทั้งหมด)
  userId        String   @map("user_id") @db.Uuid
  /// ป้ายชื่อ (เช่น "บัญชีส่วนตัว", "บัญชีเงินเดือน")
  label         String   @default("บัญชีหลัก")
  /// ชื่อธนาคาร (เช่น "กสิกร", "กรุงเทพ", "ไทยพาณิชย์")
  bankName      String   @map("bank_name")
  /// เลขบัญชี
  accountNumber String   @map("account_number")
  /// ชื่อบัญชี (ตรงกับหน้าสมุดบัญชี)
  accountName   String   @map("account_name")
  /// บัญชีหลัก (default) ของผู้ใช้
  isDefault     Boolean  @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([userId])
  @@map("bank_accounts")
}

/// การจอง — state machine 9 สถานะ, snapshot ราคา/ค่าคอม/ที่อยู่ ณ เวลาจอง
model Booking {
  /// Primary key (uuid)
  id               String         @id @default(uuid()) @db.Uuid
  /// FK → users.id ผู้เช่า (Cascade)
  renterId         String         @map("renter_id") @db.Uuid
  /// FK → shops.id (Cascade)
  shopId           String         @map("shop_id") @db.Uuid
  /// วันเริ่มเช่า
  startDate        DateTime       @map("start_date") @db.Date
  /// วันคืนสินค้า
  endDate          DateTime       @map("end_date") @db.Date
  /// เวลารับชุด "HH:MM" (null = ทั้งวัน). Logistics only — ไม่กระทบราคา/สต็อก
  startTime        String?        @map("start_time")
  /// เวลาคืนชุด "HH:MM" (null = ทั้งวัน)
  endTime          String?        @map("end_time")
  /// ค่าเช่ารวม snapshot ณ เวลาจอง (บาท)
  rentalTotal      Int            @map("rental_total")
  /// ค่ามัดจำ snapshot (บาท)
  deposit          Int            @default(0)
  /// ค่าส่ง (บาท)
  shippingFee      Int?           @map("shipping_fee")
  /// อัตราค่าคอมแพลตฟอร์ม snapshot (คงที่แม้ปรับ rate ภายหลัง)
  commissionRate   Decimal        @default(0.10) @map("commission_rate") @db.Decimal(5, 4)
  /// ยอดค่าคอมที่คำนวณแล้ว (บาท)
  commissionAmount Int?           @map("commission_amount")
  /// ช่องทาง acquisition (first-touch) ของผู้เช่า
  channel          String?
  /// สถานะการจองตาม state machine
  status           BookingStatus  @default(booking_pending)
  /// path ไฟล์สลิปโอนเงิน (private bucket)
  slipPath         String?        @map("slip_path")
  /// ช่องทางที่ร้านเลือกเก็บเงินสำหรับการจองนี้ (snapshot ณ ตอนยอมรับการจอง)
  paymentMethod    PaymentMethod? @map("payment_method")
  /// FK → addresses.id ที่อยู่ที่เลือกตอนจอง (SetNull — ใช้ snapshot ด้านล่างแสดงผล)
  addressId        String?        @map("address_id") @db.Uuid
  /// snapshot ชื่อผู้รับ
  recipientName    String?        @map("recipient_name")
  /// snapshot เบอร์โทร
  phone            String?
  /// snapshot ที่อยู่เต็ม (ข้อความ)
  addressText      String?        @map("address_text")
  /// เส้นตายของสถานะปัจจุบัน (เช่น หมดเวลาชำระเงิน)
  currentDueAt     DateTime?      @map("current_due_at") @db.Timestamptz(6)
  /// เหตุผลการยกเลิก
  cancelReason     String?        @map("cancel_reason")
  /// สถานะก่อนยกเลิก (เดิมเป็น String → ใช้ enum เดียวกับ status)
  cancelFromStatus BookingStatus? @map("cancel_from_status")
  /// ใครเป็นคนยกเลิก — shop / renter / admin / system
  cancelledBy      String?        @map("cancelled_by")

  /// ข้อความโต้แย้งจากผู้เช่า (เมื่อร้านแจ้งสลิปไม่ถูกต้อง ผู้เช่าส่งเหตุผลกลับให้แอดมินตัดสิน)
  disputeNote String? @map("dispute_note")

  /// สถานะคำขอแก้ที่อยู่หลังชำระเงิน (post-payment): null/none → requested → approved → paid_review → done | rejected.
  /// ไม่กระทบ booking.status หลัก (sub-flow คุมด้วยคอลัมน์ชุดนี้ล้วน ๆ)
  addrChangeStatus     String? @map("addr_change_status")
  /// ที่อยู่ใหม่ที่ผู้เช่าขอเปลี่ยน — snapshot ชื่อผู้รับ (รอร้านอนุมัติ)
  pendingRecipientName String? @map("pending_recipient_name")
  /// ที่อยู่ใหม่ — snapshot เบอร์โทร
  pendingPhone         String? @map("pending_phone")
  /// ที่อยู่ใหม่ — snapshot ที่อยู่เต็ม
  pendingAddressText   String? @map("pending_address_text")
  /// ค่าจัดส่งใหม่ที่ร้านคำนวณสำหรับที่อยู่ใหม่ (บาท)
  pendingShippingFee   Int?    @map("pending_shipping_fee")
  /// ส่วนต่างค่าจัดส่งที่ผู้เช่าต้องจ่ายเพิ่ม = max(0, pendingShippingFee − shippingFee) (บาท)
  addrChangeDiff       Int?    @map("addr_change_diff")
  /// path สลิปจ่ายส่วนต่าง (private bucket)
  addrChangeSlipPath   String? @map("addr_change_slip_path")
  /// เหตุผลที่ร้านปฏิเสธคำขอแก้ที่อยู่ (ถ้ามี)
  addrChangeReason     String? @map("addr_change_reason")

  /// แหล่งที่มาของการจอง: "online" = ลูกค้าจองผ่านเว็บ, "walk_in" = ร้านจองให้ลูกค้าหน้าร้าน
  source       String? @map("source")
  /// หมายเหตุภายในร้าน (ไม่แสดงต่อลูกค้า)
  internalNote String? @map("internal_note")

  /// snapshot path ของบัตรประชาชนที่ใช้ในการจองนี้ (private bucket key)
  idCardPath String? @map("id_card_path")

  /// วิธีจัดส่ง: "express" (ส่งด่วนภายในวัน) | "standard" (ขนส่งพัสดุ)
  /// คงไว้เพื่อ back-compat — มีค่าเท่ากับ outboundMethod (ขาร้านส่งให้ลูกค้า)
  deliveryMethod  String? @map("delivery_method")
  /// วิธีจัดส่งขาไป (ร้าน→ลูกค้า): "express" | "standard" — ใช้คำนวณ buffer ก่อนเริ่มเช่า
  outboundMethod  String? @map("outbound_method")
  /// วิธีส่งคืนขากลับ (ลูกค้า→ร้าน): "express" | "standard" — ใช้คำนวณ buffer หลังจบเช่า
  returnMethod    String? @map("return_method")
  /// ผู้ให้บริการขนส่ง (standard): "flash" | "kerry" | "jt" | "thaipost" | "other:<provider>"
  deliveryCarrier String? @map("delivery_carrier")
  /// ช่วงเวลารับของสำหรับส่งด่วน เช่น "14:00-18:00"
  expressSlot     String? @map("express_slot")
  /// เลขพัสดุ/เลขติดตามการจัดส่ง (กรอกตอนร้านส่งชุด)
  trackingNumber  String? @map("tracking_number")
  /// ลิงก์ติดตามการจัดส่ง (กรอกตอนร้านส่งชุด)
  trackingUrl     String? @map("tracking_url")

  /// ── ข้อมูลการส่งคืนจากลูกค้า (ขากลับ) ──
  /// ผู้ให้บริการขนส่งที่ลูกค้าใช้ส่งคืน
  returnCarrier        String?   @map("return_carrier")
  /// เลขพัสดุขากลับ
  returnTrackingNumber String?   @map("return_tracking_number")
  /// ลิงก์ติดตามขากลับ
  returnTrackingUrl    String?   @map("return_tracking_url")
  /// เวลาที่ลูกค้ากดส่งข้อมูลการส่งคืน (null = ยังไม่ได้ส่ง)
  returnShippedAt      DateTime? @map("return_shipped_at") @db.Timestamptz(6)

  /// เวลาที่ส่งแจ้งเตือน "ถึงกำหนดคืน" แล้ว (กันส่งซ้ำจาก cron sweep)
  returnReminderSentAt  DateTime? @map("return_reminder_sent_at") @db.Timestamptz(6)
  /// เวลาที่ส่งแจ้งเตือน "เกินกำหนดคืน" แล้ว (กันส่งซ้ำจาก cron sweep)
  overdueReminderSentAt DateTime? @map("overdue_reminder_sent_at") @db.Timestamptz(6)
  /// เวลาที่ร้านกดรับคืนชุด (เข้าสถานะ returned) — ใช้เป็นจุดเริ่มนับ auto-complete
  returnedAt            DateTime? @map("returned_at") @db.Timestamptz(6)
  /// สภาพชุดตอนรับคืน: "complete" (สมบูรณ์), "damaged" (มีความเสียหาย), "not_returned" (ไม่ส่งคืน)
  returnCondition       String?   @map("return_condition")
  /// รายละเอียดความเสียหายที่ร้านระบุ (เมื่อ returnCondition = "damaged")
  returnDamageNote      String?   @map("return_damage_note")
  /// จำนวนมัดจำที่หัก (บาท) — ร้านกรอกตอนบันทึก damaged (null = ยังไม่ระบุ, 0 = ไม่หัก)
  deductionAmount       Int?      @map("deduction_amount")
  /// เวลาที่เข้าสถานะ payment_review (ลูกค้าอัปสลิป) — ใช้นับชั่วโมงร้านเปิดเพื่อแสดง badge ด่วน
  /// รีเซตทุกครั้งที่ลูกค้าอัปสลิปใหม่ (เช่น หลัง slip_disputed)
  paymentReviewAt       DateTime? @map("payment_review_at") @db.Timestamptz(6)
  /// เส้นตาย auto-confirm สลิป — เลยเวลานี้ระบบ confirm อัตโนมัติ (cron sweep)
  /// คำนวณจาก 4 เงื่อนไข: same-day+เปิด(1h), same-day+ปิด(3h), >24h(24h), ≤24h(12h)
  slipConfirmDueAt      DateTime? @map("slip_confirm_due_at") @db.Timestamptz(6)
  /// เวลาที่ส่ง reminder ร้านให้ confirm สลิป (กันส่งซ้ำจาก cron)
  slipReminderSentAt    DateTime? @map("slip_reminder_sent_at") @db.Timestamptz(6)

  /// สถานะการคืนเงิน: "none" (ไม่มี), "required" (แอดมินอนุมัติยกเลิกหลังจ่ายแล้ว — รอโอนคืน),
  /// "refunded" (โอนคืนแล้ว มีสลิปยืนยัน), "forfeited" (หักมัดจำ — ลูกค้าไม่คืนของ)
  refundStatus   String?   @default("none") @map("refund_status")
  /// จำนวนเงินที่คืน (บาท) — กรอกโดยแอดมินตอนอนุมัติยกเลิก หรือตอนบันทึกการคืนเงิน
  refundAmount   Int?      @map("refund_amount")
  /// เวลาที่บันทึกว่าโอนคืนเสร็จแล้ว (admin อัปสลิปคืน)
  refundedAt     DateTime? @map("refunded_at") @db.Timestamptz(6)
  /// หมายเหตุการคืนเงิน (แอดมิน)
  refundNote     String?   @map("refund_note")
  /// path ไฟล์สลิปยืนยันการคืนเงิน (private bucket — key รูปแบบ refunds/<bookingId>/<uuid>.<ext>)
  refundSlipPath String?   @map("refund_slip_path")

  // -- Deposit refund: bank account snapshot + decision tracking --
  /// FK → bank_accounts.id (บัญชีรับมัดจำคืนของผู้เช่า — snapshot ค่าด้านล่าง)
  bankAccountId      String?   @map("bank_account_id") @db.Uuid
  /// snapshot ชื่อธนาคาร ณ เวลาจอง
  refundBankName     String?   @map("refund_bank_name")
  /// snapshot เลขบัญชี ณ เวลาจอง
  refundAccountNumber String?  @map("refund_account_number")
  /// snapshot ชื่อบัญชี ณ เวลาจอง
  refundAccountName  String?   @map("refund_account_name")
  /// ร้านตัดสินมัดจำ: "full_refund" / "partial_refund" / "forfeit"
  depositDecision    String?   @map("deposit_decision")
  /// ข้อโต้แย้งมัดจำจากผู้เช่า (แยกจาก disputeNote ของ slip)
  depositDisputeNote String?   @map("deposit_dispute_note")
  /// เส้นตาย renter verify สลิปคืนเงิน (24 ชม. หลังร้านอัปโหลด)
  refundSlipDueAt    DateTime? @map("refund_slip_due_at") @db.Timestamptz(6)
  /// เวลาที่ renter ยืนยันรับเงินคืนแล้ว
  refundVerifiedAt   DateTime? @map("refund_verified_at") @db.Timestamptz(6)
  /// วันที่สินค้าพร้อมเช่าใหม่ (ร้านกำหนดตอนรับคืน — default = endDate + buffer + cleaning)
  nextAvailableDate  DateTime? @map("next_available_date") @db.Date

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  renter      User            @relation(fields: [renterId], references: [id], onDelete: Cascade)
  shop        Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  address     Address?        @relation(fields: [addressId], references: [id], onDelete: SetNull)
  bankAccount BankAccount?    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  review      Review?
  items       BookingItem[]
  lostUnits   ProductUnit[]   @relation("LostUnits")

  @@index([renterId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("bookings")
}

/// บรรทัดรายการสินค้าในหนึ่งการจอง (order line item). Booking เป็น header;
/// หนึ่ง booking มีได้หลายรายการ (ร้านเดียวกัน + ช่วงวันเดียวกัน). Phase 1: additive — flat fields บน Booking ยังเป็น source of truth.
model BookingItem {
  id          String  @id @default(uuid()) @db.Uuid
  bookingId   String  @map("booking_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  unitId      String? @map("unit_id") @db.Uuid
  /// ค่าเช่า snapshot ของรายการนี้ (บาท)
  rentalTotal Int     @map("rental_total")
  /// ค่ามัดจำ snapshot ของรายการนี้ (บาท)
  deposit     Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unit    ProductUnit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([productId])
  @@index([variantId])
  @@index([unitId])
  @@map("booking_items")
}

// ---------------------------------------------------------------------------
// Availability
// ---------------------------------------------------------------------------

/// วันที่ร้านปิดไม่ให้จองสินค้า (blackout — เดิม dress_blackouts, composite PK (dress_id, date))
model ProductBlackoutDate {
  /// Primary key (uuid) — เพิ่มใหม่
  id        String   @id @default(uuid()) @db.Uuid
  /// FK → products.id (Cascade)
  productId String   @map("product_id") @db.Uuid
  /// FK → product_variants.id (nullable — null = ปิดทุก variant ของสินค้านี้)
  variantId String?  @map("variant_id") @db.Uuid
  /// FK → product_units.id (nullable — set = ปิดเฉพาะหน่วยรหัสนี้ในวันนั้น)
  unitId    String?  @map("unit_id") @db.Uuid
  /// วันที่ปิดจอง
  date      DateTime @db.Date

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  unit    ProductUnit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, unitId, date])
  @@index([productId])
  @@index([variantId])
  @@index([unitId])
  @@index([date])
  @@map("product_blackout_dates")
}

/// วันหยุดพิเศษ/วันปิดร้านแบบระบุวัน (one-off holidays) — mirror ของ product_blackout_dates แต่ระดับร้าน
model ShopClosedDate {
  /// Primary key (uuid)
  id     String   @id @default(uuid()) @db.Uuid
  /// FK → shops.id (Cascade)
  shopId String   @map("shop_id") @db.Uuid
  /// วันที่ปิดร้าน
  date   DateTime @db.Date
  /// หมายเหตุ (เช่น "วันสงกรานต์")
  note   String?

  /// uuid ผู้สร้าง record (NULL = system/seed)
  createdBy String?  @map("created_by") @db.Uuid
  /// เวลาสร้าง record
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// uuid ผู้แก้ไขล่าสุด
  updatedBy String?  @map("updated_by") @db.Uuid
  /// เวลาแก้ไขล่าสุด (DB trigger set_updated_at + Prisma @updatedAt)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
  @@index([shopId])
  @@index([date])
  @@map("shop_closed_dates")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Audit log รวม (host decision: merge admin_audit เข้าตารางนี้)
/// 1) mechanical before/after ของทุก mutating operation — เขียนโดย Prisma client extension
/// 2) admin business actions (approve KYC, reject product, ...) — เขียน explicit
///    โดย admin actions; เหตุผลของแอดมินเก็บใน after->>'reason'
/// append-only, ไม่มี FK ไป users (ต้องอยู่รอดแม้ user ถูก hard delete)
model AuditLog {
  /// Primary key (uuid)
  id         String      @id @default(uuid()) @db.Uuid
  /// ชนิด operation (admin business actions ใช้ UPDATE/DELETE ตาม mutation จริง)
  action     AuditAction
  /// ชื่อ entity/ตาราง (เช่น "Product", "Booking") หรือ business entity ("kyc")
  entityType String      @map("entity_type")
  /// uuid ของ row ที่ถูกกระทำ
  entityId   String?     @map("entity_id") @db.Uuid
  /// uuid ผู้กระทำจาก session (NULL = system/cron/anonymous)
  actorId    String?     @map("actor_id") @db.Uuid
  /// สภาพ row ก่อนแก้ (NULL สำหรับ CREATE)
  before     Json?
  /// สภาพ row หลังแก้ (NULL สำหรับ DELETE); admin actions ใส่ reason/action ชื่อธุรกิจที่นี่
  after      Json?
  /// เวลาเกิดเหตุการณ์
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Admin-editable key-value settings (LINE URL, contact email, etc.)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

/// Email sending log — ใช้ monitor quota / debug delivery
model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  category  String   @default("other")
  success   Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([category])
  @@map("email_logs")
}

/// ชนิด operation ใน audit_logs
enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

/// แบนเนอร์โฆษณา/โปรโมชั่นสำหรับ carousel หน้าหลัก (จัดการโดย admin)
model Banner {
  /// Primary key (uuid)
  id        String    @id @default(uuid()) @db.Uuid
  /// ชื่อแบนเนอร์ที่แสดงใน carousel
  title     String
  /// URL รูปภาพแบนเนอร์ (วาง URL ตรง ๆ)
  imageUrl  String    @map("image_url")
  /// URL ปลายทางเมื่อผู้ใช้คลิกแบนเนอร์ (null = ไม่ link)
  linkUrl   String?   @map("link_url")
  /// ลำดับการแสดงผลใน carousel (น้อย = แสดงก่อน)
  sortOrder Int       @default(0) @map("sort_order")
  /// เปิดใช้งานแบนเนอร์ (false = ซ่อน)
  isActive  Boolean   @default(true) @map("is_active")
  /// เวลาเริ่มแสดงแบนเนอร์ (null = ไม่กำหนด — แสดงทันที)
  startsAt  DateTime? @map("starts_at") @db.Timestamptz(6)
  /// เวลาสิ้นสุดการแสดงแบนเนอร์ (null = ไม่กำหนด — แสดงไม่มีกำหนด)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  /// FK → shops.id ร้านเจ้าของแบนเนอร์ (NULL = แบนเนอร์ระดับ admin/global; non-NULL = แบนเนอร์โปรโมชั่นร้านของ seller — ลบร้านแล้วแบนเนอร์หายตาม)
  shopId    String?   @map("shop_id") @db.Uuid
  /// สถานะการอนุมัติ: 'pending' (รออนุมัติ — seller สร้างใหม่) | 'approved' (อนุมัติแล้ว แสดงใน carousel) | 'rejected' (ปฏิเสธ); แบนเนอร์ admin ค่าเริ่มต้น 'approved'
  status    String    @default("approved")

  /// uuid ผู้สร้าง record (NULL = system/seed)
  createdBy String?  @map("created_by") @db.Uuid
  /// เวลาสร้าง record
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// uuid ผู้แก้ไขล่าสุด
  updatedBy String?  @map("updated_by") @db.Uuid
  /// เวลาแก้ไขล่าสุด (DB trigger set_updated_at + Prisma @updatedAt)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@index([shopId])
  @@map("banners")
}

// ---------------------------------------------------------------------------
// Reviews (renter → shop rating after completed rental)
// ---------------------------------------------------------------------------

/// enum สถานะการมองเห็นรีวิว (visible = แสดงผล, hidden = admin ซ่อน)
enum ReviewStatus {
  visible
  hidden

  @@map("review_status")
}

/// รีวิวร้านจากผู้เช่า — ผู้เช่ารีวิวได้หลังการเช่าสำเร็จ (returned/completed)
/// 1 การจองรีวิวได้ 1 ครั้ง; admin ซ่อนได้; ร้านตอบกลับได้ 1 ครั้ง
model Review {
  /// Primary key (uuid)
  id              String       @id @default(uuid()) @db.Uuid
  /// FK → users.id ผู้เขียนรีวิว (SetNull — ลบผู้ใช้แล้วรีวิวยังอยู่แต่ไม่มีชื่อ)
  reviewerId      String?      @map("reviewer_id") @db.Uuid
  /// FK → shops.id ร้านที่รีวิว (Cascade — ลบร้านแล้วรีวิวหายตาม)
  shopId          String       @map("shop_id") @db.Uuid
  /// FK → bookings.id การจองที่รีวิว (SetNull — ลบ booking แล้วรีวิวยังอยู่)
  bookingId       String?      @map("booking_id") @db.Uuid
  /// คะแนน 1-5 ดาว
  rating          Int
  /// ความเห็น (ไม่บังคับ, ≤ 1000 ตัวอักษร)
  comment         String?
  /// สถานะการแสดงผล (visible = แสดง, hidden = admin ซ่อน)
  status          ReviewStatus @default(visible)
  /// ข้อความตอบกลับของร้าน (ไม่บังคับ)
  sellerReply     String?      @map("seller_reply")
  /// เวลาที่ร้านตอบกลับ
  sellerRepliedAt DateTime?    @map("seller_replied_at") @db.Timestamptz(6)

  /// uuid ผู้สร้าง record (NULL = system/seed)
  createdBy String?  @map("created_by") @db.Uuid
  /// เวลาสร้าง record
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// uuid ผู้แก้ไขล่าสุด
  updatedBy String?  @map("updated_by") @db.Uuid
  /// เวลาแก้ไขล่าสุด (DB trigger set_updated_at + Prisma @updatedAt)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reviewer User?    @relation("UserReviews", fields: [reviewerId], references: [id], onDelete: SetNull)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([bookingId])
  @@index([shopId])
  @@index([reviewerId])
  @@index([shopId, status, createdAt(sort: Desc)])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Tag Request (seller tag-request → admin approval)
// ---------------------------------------------------------------------------

/// enum สถานะคำขอเพิ่มแท็กจากผู้ขาย
enum TagRequestStatus {
  pending
  approved
  rejected

  @@map("tag_request_status")
}

/// คำขอเพิ่มแท็กใหม่จากผู้ขาย — รอแอดมินอนุมัติสร้าง Tag จริงในระบบ
/// เมื่ออนุมัติ: สร้าง Tag ใน tag_groups เท่านั้น — ไม่แนบกับสินค้าอัตโนมัติ (seller แนบเองทีหลัง)
model TagRequest {
  /// Primary key (uuid)
  id             String           @id @default(uuid()) @db.Uuid
  /// FK → tag_groups.id กลุ่มแท็กที่ขอเพิ่ม (RESTRICT — ห้ามลบกลุ่มถ้ายังมีคำขอ)
  tagGroupId     String           @map("tag_group_id") @db.Uuid
  /// FK → shops.id ร้านที่ยื่นคำขอ (CASCADE — ลบร้านแล้วคำขอหาย)
  shopId         String           @map("shop_id") @db.Uuid
  /// ชื่อแท็กที่ขอ (ภาษาไทย, บังคับ)
  requestedLabel String           @map("requested_label")
  /// slug แท็กที่เสนอ (ตัวเลือก — admin ยืนยันหรือกำหนดใหม่ตอนอนุมัติ)
  requestedKey   String?          @map("requested_key")
  /// สถานะการตรวจ: pending / approved / rejected
  status         TagRequestStatus @default(pending)
  /// uuid แอดมินผู้ตรวจ (ไม่มี FK — ต้องอยู่รอดแม้ user ถูก hard delete)
  reviewerId     String?          @map("reviewer_id") @db.Uuid
  /// บันทึกผลการตรวจ (เหตุผลตีกลับ หรือหมายเหตุ)
  reviewNotes    String?          @map("review_notes")
  /// เวลาที่แอดมินตัดสินใจ
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  /// uuid ของ Tag ที่สร้างขึ้นเมื่ออนุมัติ (null = ยังไม่อนุมัติ; ไม่มี FK — ป้องกัน circular dependency)
  createdTagId   String?          @map("created_tag_id") @db.Uuid

  /// uuid ผู้สร้าง record (NULL = system/seed)
  createdBy String?  @map("created_by") @db.Uuid
  /// เวลาสร้าง record
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// uuid ผู้แก้ไขล่าสุด
  updatedBy String?  @map("updated_by") @db.Uuid
  /// เวลาแก้ไขล่าสุด (DB trigger set_updated_at + Prisma @updatedAt)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tagGroup TagGroup @relation(fields: [tagGroupId], references: [id], onDelete: Restrict)
  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tagGroupId])
  @@index([shopId])
  @@map("tag_requests")
}

// ---------------------------------------------------------------------------
// Enums (workflow states — kept; hard delete policy means no "deleted" states)
// ---------------------------------------------------------------------------

/// โทนสีสินค้า/ร้าน (ใช้ filter + UI)
enum Color {
  rose
  ivory
  green
  black
  navy
  red
  blue
  purple

  @@map("color")
}

/// ไซซ์สินค้า
enum Size {
  XXXS
  XXS
  XS
  S
  M
  L
  XL
  XXL
  XL3      @map("3XL")
  XL4      @map("4XL")
  FreeSize @map("Free size")

  @@map("size")
}

/// ระดับแผน/โฆษณา — รวม AdsTier + KycPlan + SubPlan เดิมให้เหลือ enum เดียว
/// (KycPlan เดิมใช้ตัวพิมพ์ใหญ่ Free/Boost/Featured → migrate เป็นตัวเล็ก)
/// MVP: ค่าเริ่มต้นสำหรับร้านใหม่คือ 'full' (ไม่จำกัด, ไม่มีการเลือกแพ็กเกจใน UI)
enum PlanTier {
  free
  boost
  featured
  full

  @@map("plan_tier")
}

/// สถานะ workflow การเผยแพร่ (shop/product)
enum Status {
  pending
  live
  rejected
  draft
  /// soft-deleted by the seller — hidden from storefront & seller list, but the
  /// row is kept so historical bookings (FK onDelete: Cascade) are preserved.
  archived

  @@map("listing_status")
}

/// สถานะ KYC rollup บนร้าน
enum KycStatus {
  none
  submitted
  verified
  rejected

  @@map("kyc_status")
}

/// สถานะการตรวจคำขอ KYC รายใบ
enum KycReviewStatus {
  pending
  approved
  rejected

  @@map("kyc_review_status")
}

/// ประเภทธุรกิจผู้ขาย
enum BusinessType {
  individual
  company

  @@map("business_type")
}

/// state machine การจอง
enum BookingStatus {
  booking_pending
  waiting_for_payment
  payment_review
  confirmed
  renting
  /// ถึงวันสุดท้ายของการเช่าแล้ว รอผู้เช่าคืนชุด (auto จาก renting ตอน 00:00 ของวันคืน)
  awaiting_return
  cancel_requested
  slip_disputed
  rejected
  cancelled
  payment_expired
  /// ผู้เช่าคืนชุดแล้ว รอร้านตรวจรับ (terminal ของวงจรที่สำเร็จ ขั้นที่ 1)
  returned
  /// ร้านตรวจรับชุดเรียบร้อย ปิดรายการเช่าสมบูรณ์ (terminal สุดท้าย)
  completed
  /// ลูกค้าไม่ส่งคืนชุด — ลูกค้ายังมีเวลาโต้แย้งได้ 48 ชม.
  not_returned
  /// ผู้เช่าโต้แย้งกรณีไม่คืนของ — รอแอดมินตัดสิน (auto-resolve 48 ชม.)
  return_disputed
  /// ผู้เช่าโต้แย้งการตัดสินมัดจำ — รอแอดมินตัดสิน (auto-resolve 48 ชม.)
  deposit_disputed

  @@map("booking_status")
}

/// สถานะของหน่วยสินค้ารายตัว (ProductUnit)
enum UnitStatus {
  /// พร้อมเช่า — นับเป็น stock
  available
  /// ออกไปกับลูกค้า (กำลังเช่า)
  rented
  /// ติดซ่อม/ไม่พร้อมเช่าชั่วคราว — ไม่นับเป็น stock
  repair
  /// ปลดระวาง — ไม่นับเป็น stock ถาวร
  retired
  /// สูญหาย — ลูกค้าไม่คืน, ไม่นับเป็น stock, มี link กลับไปหา booking
  lost

  @@map("unit_status")
}

/// สถานะ subscription
enum SubStatus {
  active
  past_due
  cancelled
  expired

  @@map("sub_status")
}

/// รอบบิล subscription
enum BillingCycle {
  monthly
  yearly

  @@map("billing_cycle")
}

/// ช่องทางการรับชำระเงิน (PromptPay หรือ โอนเข้าบัญชีธนาคาร)
enum PaymentMethod {
  promptpay
  bank

  @@map("payment_method")
}
